# hal_secure_element_default.te

hal_client_domain(hal_secure_element_default, hal_nfc)

allow hal_secure_element_default nfc_device:chr_file rw_file_perms;

allow hal_secure_element_default hal_nfc_service:service_manager find;

allow hal_secure_element_default init: unix_stream_socket connectto;

allow hal_secure_element_default rild:unix_stream_socket connectto;

allow hal_secure_element_default system_suspend_hwservice:hwservice_manager find;

allow hal_secure_element_default property_socket:sock_file write;

get_prop(hal_secure_element_default, vendor_persist_nfc_prop)

wakelock_use(hal_secure_element_default)

set_prop(hal_secure_element_default, vendor_sehal_prop)